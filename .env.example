# Copia este archivo como .env y completa tus credenciales
DB_URL=jdbc:mysql://localhost:3306/yireh_store?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=TU_PASSWORD
PORT=8080
JWT_SECRET=TU_SECRETO_MIN_32_CHARS
JWT_EXPIRATION=86400000
DDL_AUTO=update

# Admin user (_DataInitializer_)
admin.email=admin@yirehstore.com
admin.password=TU_PASSWORD_ADMIN
admin.name=Administrador

# Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
